# Default: normalize text files to LF in the repo, checkout as native
* text=auto eol=lf

# Windows-specific scripts keep CRLF on checkout
*.bat text eol=crlf
android/gradlew.bat text eol=crlf

# Unix shell scripts must stay LF
android/gradlew text eol=lf

# Binary assets — never touch line endings
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
*.jar binary
*.mp3 binary
*.wav binary
*.ogg binary
*.ttf binary
*.woff binary
*.woff2 binary
